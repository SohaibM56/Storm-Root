<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.StormRoot" parent="Theme.Material3.Light.NoActionBar">
        <!-- The rest of the app hand-tints widgets to this green per-view (backgroundTint,
             color state lists, etc); without these the M3 default purple leaks through on
             anything that relies on theme attrs instead, e.g. a Chip's surface-tint overlay. -->
        <item name="colorPrimary">@color/primary</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/surface_green_light</item>
        <item name="colorOnPrimaryContainer">@color/primary</item>
        <item name="colorSecondary">@color/primary</item>
        <item name="colorSecondaryContainer">@color/surface_green_light</item>
        <item name="colorOnSecondaryContainer">@color/primary</item>
    </style>

    <style name="Theme.StormRoot" parent="Base.Theme.StormRoot" />
</resources>